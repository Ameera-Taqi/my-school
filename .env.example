# Copy to .env and adjust. Values here are the defaults used by docker-compose.yml.
# Docker Compose talks to the bundled sqlserver service by name.
# For a SQL Server on the host instead: MSSQL_HOST=host.docker.internal
MSSQL_SA_PASSWORD=SqlServer!2026
MSSQL_HOST=sqlserver
MSSQL_HOST_PORT=1433
JWT_SECRET=SchoolPerformanceSmartIndicatorSystemSecretKey2024MustBeLongEnough
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4300,http://127.0.0.1:4200,http://127.0.0.1:4300
ASPNETCORE_ENVIRONMENT=Development
